# Allow-list .gitignore: ignore everything by default, then re-allow tracked files.
# Anything not explicitly un-ignored below stays out of git.

# 1. Ignore everything
*

# 2. Re-allow directories so git can descend into them
!*/

# 3. Re-allow top-level project files
!.gitignore
!.gitattributes
!.editorconfig
!.swiftlint.yml
!LICENSE
!README.md
!mise.toml
!project.yml
!Package.swift
!Package.resolved

# 3b. Re-allow color generator tooling under tools/
!tools/colors-source.json
!tools/package.json
!tools/package-lock.json
!tools/oklch-to-p3.mjs

# 4. Re-allow Swift source files anywhere in the tree
!*.swift

# 5. Re-allow Xcode asset catalog metadata
!Contents.json

# 6. Re-allow Info.plist / entitlements / storyboards if added later
!*.plist
!*.entitlements
!*.xcconfig
!*.storyboard
!*.xib
!*.strings
!*.stringsdict

# 7. Re-allow design specs and reference docs under docs/
!docs/**/*.md

# 7b. Re-allow GitHub repo metadata (PR/issue templates, CODEOWNERS, etc.)
!.github/**/*.md

# 7c. Re-allow README and docs image assets
!assets/**/*.png
!assets/**/*.jpg
!assets/**/*.jpeg
!assets/**/*.svg
!assets/**/*.gif
!assets/**/*.webp

# 8. Hard re-ignore for generated / build artifacts (defense in depth -
#    these would otherwise be pulled back in by rule #2).
.build/
build/
DerivedData/
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
.swiftpm/
Pods/
Carthage/Build/
.DS_Store

# Local Node dependencies for the colorset generator (run `cd tools && npm install` when colors change)
tools/node_modules
